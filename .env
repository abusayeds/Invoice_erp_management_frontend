VITE_BACKEND_BASE=https://sabbir2000.ssh.bd

# Full REST API base URL. /api/v1 is common to every endpoint.
# Relative path → requests hit the same origin and Vite proxies /api to the
# backend (see server.proxy in vite.config.ts). Avoids CORS / mixed-content
# when served over the https tunnel. For a directly-reachable backend, set the
# absolute URL instead, e.g. http://localhost:200/api/v1
VITE_API_BASE_URL=/api/v1
